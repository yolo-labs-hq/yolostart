{
  "name": "yolostart",
  "version": "0.3.13",
  "description": "Thin bootstrap for the official yolostart native CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "yolostart": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/launcher.js",
    "dist/release-url.mjs",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm run typecheck:test && npm test",
    "test:native": "node scripts/go.mjs test ./...",
    "build:native": "node scripts/build-native.mjs",
    "pack:native": "node scripts/pack-native.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.4.0"
  }
}
